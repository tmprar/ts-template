{
  "name": "create-ts-template",
  "version": "0.1.0",
  "description": "NestJS(API)+ Nuxt(web)のモノレポのひな形からプロジェクトを作る",
  "license": "UNLICENSED",
  "type": "module",
  "engines": {
    "node": ">=22"
  },
  "bin": {
    "create-ts-template": "./dist/index.js"
  },
  "files": [
    "dist",
    "template"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.build.json && node dist/bundle-dotfiles.js",
    "prepare": "npm run build",
    "lint": "template/packages/eslint-config/node_modules/.bin/eslint src --fix",
    "typecheck": "tsc --noEmit -p tsconfig.json",
    "test": "node --test \"src/**/*.spec.ts\"",
    "test:cov": "node --test --experimental-test-coverage --test-coverage-include=src/text.ts --test-coverage-branches=100 --test-coverage-functions=100 --test-coverage-lines=100 \"src/**/*.spec.ts\""
  },
  "dependencies": {
    "@clack/prompts": "~1.8.1",
    "mri": "~1.2.0"
  },
  "devDependencies": {
    "@types/node": "~24.13.4",
    "typescript": "~6.0.3"
  }
}
