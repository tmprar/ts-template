{
  "name": "myapp",
  "private": true,
  "license": "UNLICENSED",
  "packageManager": "pnpm@12.4.1",
  "devEngines": {
    "runtime": {
      "name": "node",
      "version": "24.15.0",
      "onFail": "download"
    }
  },
  "scripts": {
    "prepare": "lefthook install",
    "compose": "dotenvx run -f .env.local -f .env -- docker compose",
    "build": "turbo build",
    "lint": "turbo lint",
    "depcruise": "turbo depcruise",
    "typecheck": "turbo typecheck",
    "test": "turbo test",
    "test:cov": "turbo test:cov",
    "test:integration": "turbo test:integration",
    "test:mutation": "turbo test:mutation",
    "predev": "pnpm compose up -d --wait --build --remove-orphans",
    "dev": "dotenvx run -f .env.local -f .env -- turbo dev generate:api:watch",
    "predb": "pnpm compose up -d --wait --build --remove-orphans",
    "db": "dotenvx run -f .env.local -f .env -- pnpm --filter @myapp/api db",
    "lint:text": "textlint '**/*.md'"
  },
  "devDependencies": {
    "@commitlint/cli": "~21.2.3",
    "@commitlint/config-conventional": "~21.2.3",
    "@dotenvx/dotenvx": "~2.38.2",
    "lefthook": "~2.1.12",
    "textlint": "~16.1.2",
    "textlint-filter-rule-allowlist": "~4.0.0",
    "textlint-rule-preset-ja-technical-writing": "~12.0.2",
    "textlint-rule-prh": "~6.1.1",
    "turbo": "~2.10.12"
  }
}
