{
  "name": "myapp",
  "private": true,
  "license": "UNLICENSED",
  "packageManager": "pnpm@12.4.1",
  "devEngines": {
    "runtime": {
      "name": "node",
      "version": "24.15.0",
      "onFail": "download"
    }
  },
  "scripts": {
    "prepare": "lefthook install",
    "compose:up": "docker compose up -d --wait --build --remove-orphans",
    "compose:down": "docker compose down",
    "build": "turbo build",
    "lint": "turbo lint",
    "depcruise": "turbo depcruise",
    "typecheck": "turbo typecheck",
    "test": "turbo test",
    "test:cov": "turbo test:cov",
    "test:integration": "turbo test:integration",
    "predev": "docker compose up -d --wait --build --remove-orphans",
    "dev": "dotenv -e .env -- turbo dev generate:api:watch",
    "predb": "docker compose up -d --wait --build --remove-orphans",
    "db": "dotenv -e .env -- pnpm --filter @myapp/api db"
  },
  "devDependencies": {
    "@commitlint/cli": "~21.2.3",
    "@commitlint/config-conventional": "~21.2.3",
    "dotenv-cli": "~11.0.0",
    "lefthook": "~2.1.12",
    "turbo": "~2.10.12"
  }
}
