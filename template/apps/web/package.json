{
  "name": "@myapp/web",
  "type": "module",
  "private": true,
  "scripts": {
    "build": "nuxt build",
    "dev": "nuxt dev",
    "generate:api": "openapi-ts",
    "generate:api:watch": "wait-on http://localhost:3000/api/openapi.json && openapi-ts --watch -i http://localhost:3000/api/openapi.json | cat",
    "generate": "nuxt generate",
    "preview": "nuxt preview",
    "lint": "eslint . --fix",
    "depcruise": "depcruise app",
    "typecheck": "vue-tsc --build --force",
    "test": "vitest run --project core --project eslint",
    "test:watch": "vitest --project core --project eslint",
    "test:integration": "vitest run --project nuxt",
    "test:cov": "vitest run --coverage",
    "nuxt:prepare": "nuxt prepare",
    "postinstall": "nuxt prepare"
  },
  "dependencies": {
    "@myapp/contracts": "workspace:*",
    "@nuxt/ui": "~4.12.2",
    "@tanstack/vue-query": "~5.108.3",
    "@vueuse/core": "~15.0.0",
    "@vueuse/nuxt": "~15.0.0",
    "axios": "~1.21.1",
    "nuxt": "^4.6.4",
    "vue": "^3.5.45",
    "vue-router": "^5.5.1"
  },
  "devDependencies": {
    "@eslint/compat": "~2.1.1",
    "@hey-api/openapi-ts": "~0.99.0",
    "@myapp/api": "workspace:*",
    "@myapp/eslint-config": "workspace:*",
    "@myapp/typescript-config": "workspace:*",
    "@nuxt/eslint": "~1.17.0",
    "@nuxt/test-utils": "~4.4.0",
    "@tanstack/eslint-plugin-query": "~5.108.3",
    "@vitest/coverage-v8": "~5.1.0",
    "@vue/test-utils": "~2.6.0",
    "dependency-cruiser": "~18.8.0",
    "eslint": "~10.15.0",
    "eslint-import-resolver-typescript": "~4.4.5",
    "eslint-plugin-boundaries": "~7.4.4",
    "eslint-plugin-no-relative-import-paths": "~1.7.3",
    "eslint-plugin-vue": "~10.12.1",
    "globals": "~17.14.0",
    "happy-dom": "~21.0.0",
    "msw": "~2.15.0",
    "typescript": "~6.0.3",
    "typescript-eslint": "~8.73.0",
    "vitest": "~5.1.0",
    "vue-eslint-parser": "~10.4.2",
    "vue-tsc": "3.3.13",
    "wait-on": "~9.5.1"
  }
}
