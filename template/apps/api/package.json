{
  "name": "@myapp/api",
  "description": "",
  "author": "",
  "private": true,
  "license": "UNLICENSED",
  "type": "module",
  "exports": {
    "./openapi.json": "./.out/openapi.json"
  },
  "imports": {
    "#app/*": {
      "types": "./src/*",
      "openapi": "./.out/server/*",
      "default": "./dist/*"
    },
    "#test/*": {
      "types": "./test/*",
      "default": "./test/*"
    }
  },
  "scripts": {
    "build": "nest build",
    "start": "nest start",
    "dev": "nest start --watch --preserveWatchOutput",
    "start:debug": "nest start --debug --watch",
    "start:prod": "node dist/main",
    "generate:openapi": "nest build -p tsconfig.openapi.json && node --conditions=openapi .out/server/scripts/generate-openapi",
    "db": "drizzle-kit",
    "depcruise": "depcruise src",
    "lint": "eslint . --fix",
    "typecheck": "tsc --noEmit -p tsconfig.json",
    "test": "vitest run --project unit",
    "test:watch": "vitest --project unit",
    "test:cov": "vitest run --coverage",
    "test:integration": "vitest run --project integration",
    "test:mutation": "STRYKER=1 stryker run"
  },
  "dependencies": {
    "@myapp/contracts": "workspace:*",
    "@nestjs-cls/transactional": "~4.0.2",
    "@nestjs-cls/transactional-adapter-drizzle-orm": "~2.0.2",
    "@nestjs/common": "~12.4.2",
    "@nestjs/config": "~12.1.1",
    "@nestjs/core": "~12.4.2",
    "@nestjs/platform-express": "~12.4.2",
    "@nestjs/swagger": "~12.1.2",
    "@nestjs/terminus": "~12.1.0",
    "@scalar/nestjs-api-reference": "~1.2.39",
    "@sentry/nestjs": "~11.14.0",
    "@valibot/to-json-schema": "~1.8.0",
    "drizzle-orm": "~0.45.4",
    "eta": "~4.6.0",
    "nestjs-cls": "~7.0.2",
    "nestjs-pino": "~5.3.2",
    "neverthrow": "~8.2.0",
    "pg": "~8.23.1",
    "pg-boss": "~12.38.2",
    "pino": "~10.4.0",
    "pino-http": "~11.0.0",
    "reflect-metadata": "~0.2.2",
    "rxjs": "~7.8.2",
    "valibot": "~1.5.0"
  },
  "devDependencies": {
    "@eslint/compat": "~2.1.1",
    "@eslint/js": "~10.0.1",
    "@myapp/eslint-config": "workspace:*",
    "@myapp/typescript-config": "workspace:*",
    "@nestjs/cli": "~12.0.13",
    "@nestjs/schematics": "~12.0.13",
    "@nestjs/testing": "~12.4.2",
    "@stryker-mutator/core": "~10.1.1",
    "@stryker-mutator/typescript-checker": "~10.1.1",
    "@stryker-mutator/vitest-runner": "~10.1.1",
    "@testcontainers/postgresql": "~12.2.1",
    "@types/express": "~5.0.6",
    "@types/node": "~26.6.6",
    "@types/pg": "~8.23.1",
    "@types/supertest": "~7.2.1",
    "@vitest/coverage-v8": "~5.1.0",
    "dependency-cruiser": "~18.8.0",
    "drizzle-kit": "~0.31.11",
    "eslint": "~10.15.0",
    "eslint-import-resolver-typescript": "~4.4.5",
    "eslint-plugin-boundaries": "~7.4.4",
    "eslint-plugin-import-x": "~4.18.1",
    "eslint-plugin-n": "~18.5.0",
    "eslint-plugin-no-relative-import-paths": "~1.7.3",
    "fishery": "~2.4.0",
    "globals": "~17.14.0",
    "msw": "~2.15.0",
    "pino-pretty": "~13.2.0",
    "source-map-support": "~0.5.21",
    "supertest": "~7.3.2",
    "typescript": "~6.0.3",
    "typescript-eslint": "~8.73.0",
    "vite-tsconfig-paths": "~6.1.1",
    "vitest": "~5.1.0"
  }
}
