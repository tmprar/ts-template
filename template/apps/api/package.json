{
  "name": "@myapp/api",
  "description": "",
  "author": "",
  "private": true,
  "license": "UNLICENSED",
  "type": "module",
  "exports": {
    "./openapi.json": "./.out/openapi.json"
  },
  "imports": {
    "#app/*": {
      "types": "./src/*",
      "default": "./dist/*"
    },
    "#test/*": {
      "types": "./test/*",
      "default": "./test/*"
    }
  },
  "scripts": {
    "build": "nest build",
    "start": "nest start",
    "dev": "nest start --watch --preserveWatchOutput",
    "start:debug": "nest start --debug --watch",
    "start:prod": "node dist/main",
    "generate:openapi": "node dist/scripts/generate-openapi",
    "db": "drizzle-kit",
    "depcruise": "depcruise src",
    "lint": "eslint \"{src,test}/**/*.ts\" --fix",
    "typecheck": "tsc --noEmit -p tsconfig.json",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:cov": "vitest run --coverage",
    "test:integration": "vitest run --config ./vitest.config.e2e.ts"
  },
  "dependencies": {
    "@myapp/contracts": "workspace:*",
    "@nestjs-cls/transactional": "~3.3.0",
    "@nestjs-cls/transactional-adapter-drizzle-orm": "~1.5.0",
    "@nestjs/common": "~12.1.0",
    "@nestjs/config": "~12.0.0",
    "@nestjs/core": "~12.1.0",
    "@nestjs/platform-express": "~12.1.0",
    "@nestjs/swagger": "~12.0.2",
    "@nestjs/terminus": "~12.1.0",
    "@scalar/nestjs-api-reference": "~1.2.18",
    "@sentry/nestjs": "~11.0.0",
    "@valibot/to-json-schema": "~1.4.0",
    "drizzle-orm": "~0.45.2",
    "eta": "~4.6.0",
    "nestjs-cls": "~6.3.0",
    "nestjs-pino": "~5.2.0",
    "neverthrow": "~8.2.0",
    "pg": "~8.23.0",
    "pg-boss": "~12.31.1",
    "pino": "~10.3.1",
    "pino-http": "~11.0.0",
    "reflect-metadata": "~0.2.2",
    "rxjs": "~7.8.2",
    "valibot": "~1.2.0"
  },
  "devDependencies": {
    "@myapp/eslint-config": "workspace:*",
    "@myapp/typescript-config": "workspace:*",
    "@eslint/compat": "~2.1.1",
    "@eslint/js": "~10.0.1",
    "@nestjs/cli": "~12.0.0",
    "@nestjs/schematics": "~12.0.1",
    "@nestjs/testing": "~12.1.0",
    "@testcontainers/postgresql": "~12.1.0",
    "@types/express": "~5.0.6",
    "@types/node": "~24.13.4",
    "@types/pg": "~8.23.1",
    "@types/supertest": "~7.2.1",
    "@vitest/coverage-v8": "~4.1.11",
    "dependency-cruiser": "~18.3.1",
    "drizzle-kit": "~0.31.10",
    "eslint": "~10.10.0",
    "eslint-import-resolver-typescript": "~4.4.5",
    "eslint-plugin-boundaries": "~7.2.0",
    "eslint-plugin-import-x": "~4.17.1",
    "eslint-plugin-n": "~18.4.0",
    "eslint-plugin-no-relative-import-paths": "~1.6.1",
    "globals": "~17.12.0",
    "pino-pretty": "~13.1.3",
    "source-map-support": "~0.5.21",
    "supertest": "~7.2.2",
    "typescript": "~6.0.3",
    "typescript-eslint": "~8.70.0",
    "vite-tsconfig-paths": "~5.1.4",
    "vitest": "~4.1.11"
  }
}