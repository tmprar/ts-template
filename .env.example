# ルート共有の環境変数。`cp .env.example .env` して使う。
# ルートのスクリプト(dotenv-cli)とDocker Composeの両方がこのファイルを読む。
# APIが読む項目を足すときは apps/api/src/platform/config/env.schema.ts にも定義する。

POSTGRES_USER=myapp
POSTGRES_PASSWORD=myapp
POSTGRES_DB=myapp
POSTGRES_PORT=5432

# 上のPOSTGRES_*と整合させること
DATABASE_URL=postgresql://myapp:myapp@localhost:5432/myapp

# メールの送信(Resend)。開発では空のままでよく、その場合は送信せず文面をログに出す。
# 実際に送って確かめたいときだけ両方を設定する
# (ドメイン検証前の onboarding@resend.dev は自分のアカウントのアドレス宛にしか送れない)
RESEND_API_KEY=
MAIL_FROM=

# todo の完了を知らせるメールの宛先(サンプル)。空なら知らせない
TODO_NOTICE_MAIL_TO=

# Sentry。開発では書かない(DSN が無ければ何も送らない)
# SENTRY_DSN=
